# Meridyen Roleplay — ortam değişkenleri
# Gerçek değerler yalnızca .env dosyasına yazılır. Bu dosyada secret bulunmaz (docs/SRS.md SEC-040).
# Ayrıntı: docs/ARCHITECTURE.md §14

APP_NAME="Meridyen Roleplay"
APP_ENV=local
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=roleplay_web
DB_USERNAME=roleplay_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# Production: SESSION_COOKIE=__Host-mrp_session ve SESSION_SECURE_COOKIE=true
SESSION_COOKIE=mrp_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Yerelde sync: e-postalar worker gerekmeden log/Mailpit’e düşer. Production: database (+ queue:work).
QUEUE_CONNECTION=sync

CACHE_STORE=database
CACHE_PREFIX=mrp_

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Geliştirme: Mailpit (127.0.0.1:1025, arayüz :8025) veya MAIL_MAILER=log
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@meridyen-rp.test"
MAIL_FROM_NAME="${APP_NAME}"

# MTA köprüsü (docs/ARCHITECTURE.md §7) — rastgele 32 byte hex
BRIDGE_SERIAL_PEPPER=

# Ödeme (docs/PRD.md OD-04)
PAYMENTS_PROVIDER=fake

# PWA service worker'ı geliştirmede kaydet (docs/ARCHITECTURE.md §8.5)
PWA_DEV=false

VITE_APP_NAME="${APP_NAME}"
